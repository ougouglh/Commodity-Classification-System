# LLM API 配置
# LLM提供商: openai, yi, lmstudio, custom
LLM_PROVIDER=openai

# LLM模型名称
# OpenAI: gpt-5.5
# Yi: yi-large, yi-large-rag, yi-medium
# 自定义API: 根据你的API提供商设置
LLM_MODEL=gpt-5.5

# API密钥
# OpenAI API Key
OPENAI_API_KEY=your-api-key-here

# API基础URL（用于自定义API或代理）
# 示例: https://api.openai.com/v1
# 示例: https://api.lmstudio.ai/v1
# 示例: http://localhost:11434/v1
API_BASE_URL=

# BGE模型配置（可选，默认使用bge-base-zh-v1.5）
BGE_MODEL_NAME=BAAI/bge-base-zh-v1.5

# ============ 检索配置 ============

# 检索返回数量
RETRIEVAL_TOP_K=3

# 候选数量（用于混合检索前）
RETRIEVAL_CANDIDATE_K=8

# 品牌匹配加分（匹配品牌时加的分）
BRAND_BOOST_SCORE=0.15

# 混合检索权重（向量检索权重 0-1，BM25权重为 1-alpha）
# 0.7 = 70%向量 + 30%BM25
HYBRID_ALPHA=0.7

# ============ 性能配置 ============

# 并发线程数
MAX_WORKERS=4

# 批量大小
BATCH_SIZE=10

# 启用缓存
ENABLE_CACHE=true
CACHE_SIZE=1000
