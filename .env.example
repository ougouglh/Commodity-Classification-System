# LLM API 配置
# LLM提供商: openai, yi, lmstudio, custom
LLM_PROVIDER=openai

# LLM模型名称
# OpenAI: gpt-5.5
# Yi: yi-large, yi-large-rag, yi-medium
# 自定义API: 根据你的API提供商设置
LLM_MODEL=gpt-5.5

# API密钥
# OpenAI API Key
OPENAI_API_KEY=your-api-key-here

# API基础URL（用于自定义API或代理）
# 示例: https://api.openai.com/v1
# 示例: https://api.lmstudio.ai/v1
# 示例: http://localhost:11434/v1
API_BASE_URL=

# BGE模型配置（可选，默认使用bge-base-zh-v1.5）
BGE_MODEL_NAME=BAAI/bge-base-zh-v1.5
